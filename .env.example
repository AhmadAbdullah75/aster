# Copy with scripts/setup.ps1; setup generates local credentials without displaying them.
# Free-only default. Create a free-tier Google AI Studio project; keep billing disabled.
AI_PROVIDER=gemini
FREE_ONLY=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
WEB_BACKEND=ddgs
# Optional free Tavily account: set WEB_BACKEND=tavily, keep pay-as-you-go disabled.
TAVILY_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional original-spec adapter, disabled by FREE_ONLY. No automatic provider fallback.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://nexus:GENERATE_LOCAL_PASSWORD@127.0.0.1:5434/nexus
# Containers use postgres:5432 instead of 127.0.0.1:5434 (Compose overrides this).
POSTGRES_USER=nexus
POSTGRES_PASSWORD=GENERATE_LOCAL_PASSWORD
POSTGRES_DB=nexus
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=GENERATE_RANDOM_SECRET
DATA_DIR=.data
UPLOAD_LIMIT_MIB=10
USER_QUOTA_MIB=200
REQUEST_TIMEOUT_SECONDS=60
RUN_TIMEOUT_SECONDS=180
MAX_TOOL_CALLS=12
MAX_OUTPUT_TOKENS=4096
CONTEXT_TOKENS=16000
SESSION_DAYS=14
COOKIE_SECURE=false
